# ==============================================================================
# Backend Configuration (.env)
# ==============================================================================
PROJECT_NAME="NeuroSurgical AI - Brain Tumor Detection & Localization"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# CORS settings (Frontend Vite dev server default)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Hardware & Inference settings (CPU for local laptop)
DEVICE="cpu"
MODEL_WEIGHTS_PATH="../models/exports/model_weights.pth"

# Storage paths (Relative to backend or absolute)
DATA_RAW_DIR="../data/raw"
DATA_PROCESSED_DIR="../data/processed"
REPORTS_DIR="../reports/generated"

# Upload Constraints
MAX_UPLOAD_SIZE_MB=250
ALLOWED_EXTENSIONS=[".nii",".nii.gz",".dcm"]
